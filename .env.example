# Environment Variables for OfferCheck
# Never commit real API keys or secrets to version control.
# Copy this file to .env.local for local development.

# Required: Google Gemini API key (Server-side only)
# Get a key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Ordered fallback chain of models (comma-separated, max 3).
# Default: gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_MODELS=

# Optional: Legacy single-model override (used only if GEMINI_MODELS is unset)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Thinking level override (applied only to models that document it)
# Options: low, minimal, medium, high
# Default: uses the lowest documented level per model ("low" for 3.8-flash; "minimal" for 3.6-flash and 3.5-flash-lite)
# GEMINI_THINKING_LEVEL=low

# Optional: Groq API key for review fallback chain and clear doubt helper (Server-side only)
# Get a free key from Groq Console (https://console.groq.com/)
# GROQ_API_KEY=

# Optional: Groq model override (Default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: In-memory sliding-window rate limit overrides (for testing or staging)
# RATE_LIMIT_PER_WINDOW=8   # Maximum analyses per 15-minute window (default: 8)
# RATE_LIMIT_PER_DAY=30      # Maximum analyses per 24-hour day (default: 30)


